[Unit]
Description=nowby Sevilen sarki bildirimi - Hetzner arsivi + APNs
After=network-online.target postgresql.service

[Service]
WorkingDirectory=/opt/simdi/sevilen
EnvironmentFile=/opt/simdi/sevilen/apns.env
ExecStart=/usr/bin/node sevilen.mjs
Restart=always
RestartSec=30
MemoryMax=200M

[Install]
WantedBy=multi-user.target
